# Bastion's settings for compose.yaml. Copy this to .env beside it and fill it in: cp .env.example .env

# Required: the address people and agents reach the panel at, through your reverse proxy, with HTTPS.
BASTION_PUBLIC_URL=https://bastion.example.com

# Where the panel's port listens. Leave it at 127.0.0.1 when the reverse proxy is on this machine. When the
# proxy is on another machine, put this machine's LAN address here (e.g. 10.10.70.20), and let only the
# proxy reach the port (docs/install.md shows how).
BASTION_BIND=127.0.0.1

# The port the reverse proxy forwards to.
BASTION_PORT=8080

# Believe the address the reverse proxy says a visitor has, for sign-in limits. Keep true behind a proxy.
BASTION_TRUST_PROXY=true

# Sign-ins end after this long without use.
BASTION_SESSION_IDLE=12h

# DNS servers the panel asks when a name can't be looked up the usual way (Docker's DNS inside a container
# fails on some hosts: "server misbehaving"). Names your own DNS knows are never sent to these. off for none.
BASTION_DNS_FALLBACK=1.1.1.1,9.9.9.9

# The image's version: latest, or one like 0.4.0 to stay on it.
BASTION_VERSION=latest
